generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id           String   @id @default(uuid())
  name         String
  email        String
  password     String
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  }

  enum JobStatus {
  PENDING
  PROCESING
  COMPLEETED
  FAILED
}

  model Jobs {
    id  String @id @default(uuid())

    title String 

    description String

    status JobStatus  @default(PENDING)

    
  }

